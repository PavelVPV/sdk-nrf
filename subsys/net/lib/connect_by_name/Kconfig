menuconfig CONNECT_BY_NAME
	bool "Host address iterator"
	depends on NET_SOCKETS
	help
	  Resolve a host name and iterate over the addresses that are usable
	  now. The application connects to each address.

if CONNECT_BY_NAME

config CONNECT_BY_NAME_READINESS
	bool "Track connectivity readiness"
	depends on NET_CONNECTION_MANAGER
	default n if NRF_MODEM_LIB && !NRF_MODEM_LIB_NET_IF
	default y
	help
	  Track IPv4, IPv6 and DNS readiness through connection manager events.
	  Only families that are up are resolved and returned, and
	  connect_by_name_resolve() waits for the network to be ready. Disable
	  when no network interface reports these events.

config CONNECT_BY_NAME_MODEM_READINESS
	bool "Query the modem for readiness"
	depends on NRF_MODEM_LIB && NET_SOCKETS_OFFLOAD && !CONNECT_BY_NAME_READINESS
	default y
	help
	  Without readiness tracking, check the IP addresses of the modem's
	  default PDN with AT+CGPADDR. Only families that are up are resolved
	  and returned, and waiting for the network polls the modem.

config CONNECT_BY_NAME_MODEM_POLL_INTERVAL_MS
	int "Modem readiness poll interval (ms)"
	depends on CONNECT_BY_NAME_MODEM_READINESS
	default 1000
	help
	  How often the modem is queried while waiting.

module = CONNECT_BY_NAME
module-str = Host address iterator
source "subsys/logging/Kconfig.template.log_config"

endif # CONNECT_BY_NAME
